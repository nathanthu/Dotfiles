#!/usr/bin/env bash
# Bascule clair/sombre dans DMS et change le fond d'écran en conséquence.

LIGHT="$HOME/pic/wallpapers/monet_waterlilies.jpg"
DARK="$HOME/pic/wallpapers/monet_night_bloody.jpg"

mode=$(dms ipc call theme toggle)

if [[ "$mode" == "dark" ]]; then
    dms ipc call wallpaper set "$DARK"
else
    dms ipc call wallpaper set "$LIGHT"
fi
